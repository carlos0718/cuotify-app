# Supabase Configuration
# Obtén estos valores de tu proyecto en https://app.supabase.com
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Expo Project ID (para notificaciones push)
# Obtén este valor de tu proyecto en https://expo.dev
EXPO_PROJECT_ID=tu-expo-project-id

# RevenueCat API Keys (una por plataforma)
# Obtén estos valores en https://app.revenuecat.com > Project settings > API keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_tu-key-de-ios
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_tu-key-de-android
